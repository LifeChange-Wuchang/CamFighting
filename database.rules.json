{
  "rules": {
    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.child('meta/hostUid').val() === auth.uid)",
        "meta": {
          "status": {
            ".validate": "newData.val() === 'lobby' || newData.val() === 'running' || newData.val() === 'ended'"
          },
          "hostUid": {
            ".validate": "newData.isString()"
          }
        },
        "config": {
          "hitDamage": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 1000"
          },
          "captureHoldSec": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 120"
          },
          "fireCooldownSec": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 600"
          },
          "durationMin": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 600"
          },
          "captureHealPct": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
          },
          "captureCooldownSec": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3600"
          },
          "chestCooldownSec": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3600"
          },
          "holdRegenPct": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
          },
          "maxHp": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 1000000"
          },
          "startHpPct": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 100"
          }
        },
        "teams": {
          "$team": {
            "hp": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= newData.parent().child('maxHp').val()",
              ".write": "auth != null && root.child('rooms').child($code).child('players').child(auth.uid).exists()"
            },
            "hits": {
              ".validate": "newData.isNumber() && newData.val() >= 0",
              ".write": "auth != null && root.child('rooms').child($code).child('players').child(auth.uid).exists()"
            },
            "captures": {
              ".validate": "newData.isNumber() && newData.val() >= 0",
              ".write": "auth != null && root.child('rooms').child($code).child('players').child(auth.uid).exists()"
            },
            "label": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 8"
            },
            "accent": {
              ".validate": "newData.isString() && newData.val().length <= 9"
            },
            "color": {
              "hue": {
                ".validate": "newData.isString() && newData.val().length <= 40"
              },
              "sat": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1"
              },
              "val": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1"
              }
            }
          }
        },
        "players": {
          "$uid": {
            ".write": "auth != null && ($uid === auth.uid || root.child('rooms').child($code).child('meta').child('hostUid').val() === auth.uid)",
            "name": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 12"
            },
            "team": {
              ".validate": "newData.val() === 'host' || root.child('rooms').child($code).child('teams').hasChild(newData.val())"
            }
          }
        },
        "points": {
          ".write": "auth != null && root.child('rooms').child($code).child('players').child(auth.uid).exists()",
          "$pid": {
            "type": {
              ".validate": "newData.val() === 'capture' || newData.val() === 'chest'"
            },
            "label": {
              ".validate": "newData.isString() && newData.val().length <= 16"
            },
            ".validate": "$pid.matches(/^M[0-9][0-9]$/)"
          }
        },
        "feed": {
          ".write": "auth != null && root.child('rooms').child($code).child('players').child(auth.uid).exists()",
          "$fid": {
            "msg": {
              ".validate": "newData.isString() && newData.val().length <= 120"
            }
          }
        }
      }
    },
    "hostRooms": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    }
  }
}